<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
 <Bundle Name="Dreamsign Revit MCP" Manufacturer="Dreamsigner" Version="0.6.0" UpgradeCode="07BBE309-7A63-480C-88FA-2D13C36C119E">
  <BootstrapperApplication>
   <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense" LicenseUrl="https://github.com/Dreamsigner/Dreamsign_Revit_MCP/blob/main/LICENSE" SuppressOptionsUI="yes"/>
  </BootstrapperApplication>
  <Chain>
   <MsiPackage SourceFile="$(var.Dreamsign.Package.TargetPath)" Compressed="yes" Visible="no" Vital="yes">
    <MsiProperty Name="DREAMSIGN_BUNDLE_DISPLAY" Value="[WixBundleUILevel]"/>
   </MsiPackage>
  </Chain>
 </Bundle>
</Wix>
