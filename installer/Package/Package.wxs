<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
 <Package Name="Dreamsign Revit MCP" Manufacturer="Dreamsigner" Version="0.6.0" Language="1036"
  UpgradeCode="D9A49428-FEA6-4A2A-8E09-8D29CFE3DBE9" Scope="perMachine">
  <MajorUpgrade DowngradeErrorMessage="Une version plus récente de Dreamsign Revit MCP est déjà installée." Schedule="afterInstallInitialize"/>
  <MediaTemplate EmbedCab="yes"/>
  <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable"/>
  <Property Id="REBOOT" Value="ReallySuppress"/>
  <Property Id="DREAMSIGN_BUNDLE_DISPLAY" Secure="yes"/>
  <Binary Id="DreamsignSessionGuard" SourceFile="$(var.Dreamsign.Setup.Guard.TargetDir)Dreamsign.Setup.Guard.CA.dll"/>
  <CustomAction Id="WaitForRevitExit" BinaryRef="DreamsignSessionGuard" DllEntry="WaitForRevitExit" Execute="immediate" Return="check"/>
  <InstallExecuteSequence>
   <Custom Action="WaitForRevitExit" Before="InstallValidate" Condition="Installed AND REMOVE~=&quot;ALL&quot;"/>
  </InstallExecuteSequence>
  <Property Id="EXISTING_SHARED_MANIFEST">
   <RegistrySearch Id="FindMachineProgramsRoot" Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion" Name="ProgramFilesDir" Type="directory" Bitness="always64">
    <DirectorySearch Id="FindSharedManifestDirectory" Path="Autodesk\Revit\Addins\2027" Depth="0">
     <FileSearch Id="FindSharedManifest" Name="AstraRevitBridge.addin"/>
    </DirectorySearch>
   </RegistrySearch>
  </Property>
  <Property Id="MACHINE_PROGRAMS_SEARCH_ROOT"><RegistrySearchRef Id="FindMachineProgramsRoot"/></Property>
  <Launch Condition="Installed OR MACHINE_PROGRAMS_SEARCH_ROOT" Message="Le dossier des programmes Windows n’a pas pu être déterminé. Installation interrompue pour préserver les compléments existants."/>
  <Launch Condition="Installed OR WIX_UPGRADE_DETECTED OR NOT EXISTING_SHARED_MANIFEST" Message="Un manifeste commun AstraRevitBridge.addin existe déjà. Faites vérifier son origine avant d’installer Dreamsign MCP ; aucun remplacement automatique n’est effectué."/>
  <StandardDirectory Id="ProgramFiles64Folder">
   <Directory Id="DreamsignPrograms" Name="DreamsignRevitMCP"><Directory Id="INSTALLFOLDER" Name="0.6.0">
    <Component Id="ServerPayload" Guid="AB856BE9-4E21-4EB5-BE46-10203AFCC933">
     <File Id="ServerExecutable" Source="$(var.PayloadDirectory)\Dreamsign.Revit.Mcp.exe" KeyPath="yes"/>
     <File Source="$(var.PayloadDirectory)\README.md"/>
     <File Source="$(var.PayloadDirectory)\LICENSE"/>
     <File Source="$(var.PayloadDirectory)\THIRD-PARTY-NOTICES.md"/>
     <RegistryValue Root="HKLM" Key="Software\Dreamsigner\RevitMCP" Name="Server" Type="string" Value="[#ServerExecutable]"/>
     <RegistryValue Root="HKLM" Key="Software\Dreamsigner\RevitMCP" Name="Version" Type="string" Value="0.6.0"/>
     <RemoveFolder Id="RemoveVersion" On="uninstall"/>
     <RemoveFolder Id="RemoveProgramsRoot" Directory="DreamsignPrograms" On="uninstall"/>
    </Component>
    <Directory Id="AddinPayloadDirectory" Name="addin">
     <Component Id="AddinPayload" Guid="C81FF8EE-642E-4474-B768-E1298B530E32">
      <File Id="RevitAssembly" Source="$(var.PayloadDirectory)\addin\Dreamsign.Revit.dll" KeyPath="yes"/>
      <File Source="$(var.PayloadDirectory)\addin\Dreamsign.Contracts.dll"/>
      <File Source="$(var.PayloadDirectory)\addin\Dreamsign.Desktop.dll"/>
      <File Source="$(var.PayloadDirectory)\addin\Tomlyn.dll"/>
      <RemoveFolder Id="RemoveAddinPayload" On="uninstall"/>
     </Component>
    </Directory>
    <Directory Id="LicenseDirectory" Name="licenses">
     <Component Id="LicensePayload" Guid="94C92A5B-6AAC-409E-AB63-C1E3C65738D7">
      <File Source="$(var.PayloadDirectory)\licenses\DOTNET-LICENSE.txt" KeyPath="yes"/>
      <File Source="$(var.PayloadDirectory)\licenses\DOTNET-ThirdPartyNotices.txt"/>
      <File Source="$(var.PayloadDirectory)\licenses\MCP-Apache-2.0.txt"/>
      <File Source="$(var.PayloadDirectory)\licenses\Tomlyn-BSD-2-Clause.txt"/>
      <File Source="$(var.PayloadDirectory)\licenses\WiX-MS-RL.txt"/>
      <RemoveFolder Id="RemoveLicenses" On="uninstall"/>
     </Component>
    </Directory>
   </Directory></Directory>
   <Directory Id="AutodeskPrograms" Name="Autodesk"><Directory Id="RevitPrograms" Name="Revit">
    <Directory Id="RevitAddins" Name="Addins"><Directory Id="Revit2027Addins" Name="2027">
     <Component Id="SharedManifest" Guid="59DC39E6-B675-4997-90D1-5D9E67E0EFA1">
      <File Id="ManifestFile" Source="MachineManifest.xml" Name="AstraRevitBridge.addin" KeyPath="yes"/>
      <util:XmlFile Id="SetAssemblyPath" File="[#ManifestFile]" ElementPath="/RevitAddIns/AddIn/Assembly" Value="[#RevitAssembly]" Action="setValue" SelectionLanguage="XPath"/>
     </Component>
    </Directory></Directory>
   </Directory></Directory>
  </StandardDirectory>
  <Feature Id="Complete" Title="Dreamsign Revit MCP">
   <ComponentRef Id="ServerPayload"/><ComponentRef Id="AddinPayload"/><ComponentRef Id="LicensePayload"/><ComponentRef Id="SharedManifest"/>
  </Feature>
 </Package>
</Wix>
