<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Dreamsign.Revit.Mcp</AssemblyName>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Dreamsign.Contracts/Dreamsign.Contracts.csproj" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../LICENSE;../../THIRD-PARTY-NOTICES.md;../../README.md" Link="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../licenses/*" Link="licenses/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="StageRevitAddin" AfterTargets="Publish" Condition="'$(IncludeRevitAddin)' == 'true'">
    <PropertyGroup><RevitAddinDirectory Condition="'$(RevitAddinDirectory)' == ''">$(MSBuildProjectDirectory)/../Dreamsign.Revit/bin/$(Configuration)/net10.0-windows</RevitAddinDirectory></PropertyGroup>
    <Error Condition="!Exists('$(RevitAddinDirectory)/Dreamsign.Revit.dll')" Text="Build Dreamsign.Revit in this configuration before publishing the distribution." />
    <Copy SourceFiles="$(RevitAddinDirectory)/Dreamsign.Revit.dll;$(RevitAddinDirectory)/Dreamsign.Contracts.dll" DestinationFolder="$(PublishDir)addin" />
  </Target>
</Project>
