<Window x:Class="Dreamsign.Desktop.ControlPanelWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Dreamsign MCP" Width="760" Height="880" MinWidth="600" MinHeight="600" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" WindowStartupLocation="CenterOwner"
 FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="PanelTheme.xaml"/>
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Window.Background><StaticResource ResourceKey="Canvas"/></Window.Background>
 <Window.Foreground><StaticResource ResourceKey="Ink"/></Window.Foreground>
 <Grid Background="{StaticResource Canvas}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="32,24">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource Accent}" CornerRadius="12" Width="44" Height="44" Margin="0,0,12,0">
     <TextBlock Text="D" Foreground="White" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
     <TextBlock Text="Dreamsign" FontSize="19" FontWeight="SemiBold"/>
     <TextBlock Text="MCP pour Revit" Style="{StaticResource SecondaryText}" Margin="0,2,0,0"/>
    </StackPanel>
    <Border Grid.Column="2" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal"><Ellipse Fill="{StaticResource Accent}" Width="6" Height="6" Margin="0,0,8,0"/>
      <TextBlock x:Name="BridgeStatus" Text="Bridge chargé" FontSize="12"/>
     </StackPanel>
    </Border>
   </Grid>
  </Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,24,32,20">
   <StackPanel>
    <TextBlock Text="Connexion au projet" FontSize="28" FontWeight="SemiBold"/>
    <TextBlock Text="Votre projet Revit, relié à votre assistant." Foreground="{StaticResource MutedInk}" Margin="0,6,0,24"/>
    <Border Style="{StaticResource GroupSurface}" Margin="0,0,0,16">
     <StackPanel>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="01  /  Projet de travail" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
       <Border x:Name="TargetBadge" Grid.Column="1" Background="{StaticResource Canvas}" CornerRadius="10" Padding="10,4">
        <TextBlock x:Name="TargetBadgeText" Text="À sélectionner" FontSize="11" Foreground="{StaticResource MutedInk}"/>
       </Border>
      </Grid>
      <TextBlock x:Name="ActiveProjectText" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,16,0,4"/>
      <TextBlock x:Name="ActivePathText" Style="{StaticResource SecondaryText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="TargetText" Style="{StaticResource SecondaryText}" Margin="0,12,0,0"/>
      <Grid Margin="0,20,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="Changer d’onglet ne change pas le projet autorisé." Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
       <Button x:Name="UseProjectButton" Grid.Column="2" Content="Utiliser ce projet" Style="{StaticResource PrimaryButton}" Click="SelectProject"
        AutomationProperties.Name="Utiliser le projet Revit actif"/>
      </Grid>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource GroupSurface}">
     <StackPanel>
      <TextBlock Text="02  /  Votre assistant" FontSize="13" FontWeight="SemiBold"/>
      <Grid Margin="0,16,0,20">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><Label Target="{Binding ElementName=ClientChoice}" Content="Assistant" Padding="0" Foreground="{StaticResource MutedInk}" FontSize="12"/>
        <ComboBox x:Name="ClientChoice" SelectedIndex="0" AutomationProperties.Name="Assistant à configurer">
         <ComboBoxItem Content="Codex"/><ComboBoxItem Content="Claude Desktop"/><ComboBoxItem Content="Cursor"/>
        </ComboBox>
       </StackPanel>
       <StackPanel Grid.Column="2"><Label Target="{Binding ElementName=ProfileChoice}" Content="Utilisation" Padding="0" Foreground="{StaticResource MutedInk}" FontSize="12"/>
        <ComboBox x:Name="ProfileChoice" SelectedIndex="2" AutomationProperties.Name="Mode d’utilisation">
         <ComboBoxItem Content="Lecture seule"/><ComboBoxItem Content="Automatisation"/><ComboBoxItem Content="Modélisation"/>
        </ComboBox>
       </StackPanel>
      </Grid>
      <Button x:Name="ConnectButton" Content="Configurer la connexion" Click="ConnectClient" HorizontalAlignment="Left"/>
      <TextBlock Text="Vos réglages sont sauvegardés avant chaque changement." Style="{StaticResource SecondaryText}" Margin="0,12,0,0"/>
     </StackPanel>
    </Border>
    <Expander x:Name="AdvancedSettings" Header="Configuration avancée" Margin="4,20,0,0" Foreground="{StaticResource MutedInk}" FontSize="12">
     <StackPanel Margin="0,12,0,0"><TextBlock x:Name="StorageText" Style="{StaticResource SecondaryText}"/>
      <Button Content="Copier la configuration pour un autre client" Click="CopyConfiguration" HorizontalAlignment="Left" Margin="0,12,0,0"/>
     </StackPanel>
    </Expander>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="32,16,32,20">
   <StackPanel>
    <TextBlock x:Name="FeedbackText" Text="Choisissez le projet que votre assistant pourra utiliser." TextWrapping="Wrap" FontSize="12"
     AutomationProperties.LiveSetting="Polite" Margin="0,0,0,16"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button Content="Diagnostic" Click="Diagnose"/>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
      <TextBlock x:Name="ContactText" Style="{StaticResource SecondaryText}"/>
      <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedInk}" FontSize="11" Margin="0,4,0,0"/>
     </StackPanel>
     <Button Grid.Column="2" Content="Terminer" Click="ClosePanel" MinWidth="96"/>
    </Grid>
   </StackPanel>
  </Border>
 </Grid>
</Window>
